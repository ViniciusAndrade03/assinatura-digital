# ===== Segredos do docker-compose — copie para ".env" e troque TODOS os valores =====
# O arquivo .env está no .gitignore e nunca deve ser versionado.
# Gerar segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-esta-senha-root
MONGO_APP_USER=assinatura_app
MONGO_APP_PASSWORD=troque-esta-senha-app

JWT_SECRET=troque-por-um-segredo-aleatorio-com-48-caracteres-ou-mais
CSRF_SECRET=troque-por-outro-segredo-aleatorio-com-48-caracteres
SERVER_KEY_SECRET=troque-por-um-terceiro-segredo-aleatorio-48-caracteres

# Senha inicial dos usuários de demonstração (gerente/aprovador/colaborador @empresa.com)
SEED_PASSWORD=Senha@123
