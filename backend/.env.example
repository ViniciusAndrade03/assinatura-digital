# ===== API — copie para .env (desenvolvimento) ou configure no provedor (produção) =====
NODE_ENV=development
PORT=4000

# MongoDB local (Docker) ou MongoDB Atlas (produção):
# mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/assinatura?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/assinatura

# Segredos (mín. 32 caracteres). Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
SERVER_KEY_SECRET=
JWT_EXPIRES_IN=1h

# Origens autorizadas a chamar a API (frontend). Ex.: https://seu-usuario.github.io
CORS_ORIGINS=http://localhost:3000
# URL pública do frontend (links nos e-mails). Ex.: https://seu-usuario.github.io/assinatura-digital
APP_URL=http://localhost:3000
# Recusa requisições sem HTTPS (padrão: true em produção)
# FORCE_HTTPS=true

# E-mail (Nodemailer). Sem SMTP_HOST os e-mails são apenas registrados no log.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + "senha de app"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Assinatura Digital <no-reply@empresa.com>"

# Cria gerente/aprovador/colaborador de demonstração se o banco estiver vazio
SEED_ON_START=true
SEED_PASSWORD=Senha@123
